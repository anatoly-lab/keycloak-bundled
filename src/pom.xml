<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.herdo.keycloak</groupId>
    <artifactId>keycloak-remember-me-authenticator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Keycloak Remember Me Authenticator</name>
    <description>
        Vendored Keycloak SPI plugin that unconditionally sets the rememberMe auth-session note
        after authentication, so every auth path (direct login, social/IdP brokered login)
        produces a persistent KEYCLOAK_IDENTITY cookie.

        Vendored from https://github.com/Herdo/keycloak-remember-me-authenticator (MIT).
        See NOTICE for provenance.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <version.keycloak>26.7.3</version.keycloak>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                Keycloak parent BOM. Per Keycloak's server-development docs
                (docs/documentation/server_development/topics/providers.adoc),
                importing keycloak-parent aligns all org.keycloak:* artifact versions
                with the targeted Keycloak release.
            -->
            <dependency>
                <groupId>org.keycloak</groupId>
                <artifactId>keycloak-parent</artifactId>
                <version>${version.keycloak}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            keycloak-core: org.keycloak.Config (used by AuthenticatorFactory#init).
        -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            keycloak-server-spi: public SPI surface.
            Provides:
              - org.keycloak.events.Details
              - org.keycloak.models.{KeycloakSession, KeycloakSessionFactory,
                                    RealmModel, UserModel, AuthenticationExecutionModel}
              - org.keycloak.provider.ProviderConfigProperty
        -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            keycloak-server-spi-private: internal/authentication SPI surface.
            Provides:
              - org.keycloak.authentication.{AuthenticationFlowContext, Authenticator,
                                             AuthenticatorFactory, ConfigurableAuthenticatorFactory}
        -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-server-spi-private</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            keycloak-services: AbstractOIDCProtocolMapper and the OIDC mapper interfaces
            (OIDCAccessTokenMapper) live here, not in server-spi-private, in 26.7.2. Also
            provides ClientRegistrationPolicy / ClientRegistrationPolicyFactory for the
            resource-audience-scope policy.
        -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-services</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ================================================================
             Test dependencies (all test-scoped; do not affect the plugin JAR)
             ================================================================ -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>

        <!--
            org.keycloak.services.ErrorResponseException extends jakarta.ws.rs.WebApplicationException,
            whose constructor eagerly builds a jakarta.ws.rs.core.Response via
            jakarta.ws.rs.ext.RuntimeDelegate.getInstance(), a ServiceLoader lookup. In the real
            server this is satisfied by Quarkus/RESTEasy at runtime; on the plain unit-test classpath
            there is no JAX-RS implementation, so constructing the exception throws
            ClassNotFoundException. Pulled in at test scope only so ResourceAudienceMapperTest can
            actually construct/assert on the exception the mapper throws in strict mode.
        -->
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-core</artifactId>
            <version>6.2.12.Final</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.21.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.3</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.5.2</version>
            <scope>test</scope>
        </dependency>

        <!--
            REST Assured pulls in Apache HttpClient transitively; HttpClient
            needs commons-logging at runtime. The Keycloak BOM (imported above
            in <dependencyManagement>) appears to over-constrain or exclude
            commons-logging, so we add it back explicitly at test scope.
            Reproduces as NoClassDefFoundError: org/apache/commons/logging/LogFactory
            during RestAssured static init if missing.
        -->
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.4.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Predictable JAR name for the Dockerfile COPY step. -->
        <finalName>keycloak-remember-me-authenticator</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!--
                Surefire runs unit tests (*Test.java) during the test phase.
                JUnit Platform provider is auto-detected via junit-jupiter on the classpath.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>

            <!--
                Failsafe runs integration tests (*IT.java) bound to the
                integration-test and verify lifecycle phases.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
